          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "credential_source_id",
        "ordinal",
        "enabled"
      ],
      "title": "CredentialPoolMember",
      "type": "object"
    },
    "CredentialSource": {
      "$defs": {
        "CredentialKind": {
          "description": "Where a secret physically lives (the materialization axis).",
          "oneOf": [
            {
              "const": "vault",
              "description": "Secret material sealed in the vault (a [`SecretRef`] into [`SecretStore`]).",
              "type": "string"
            },
            {
              "const": "env",
              "description": "A host environment variable named by `env_key`; nothing is stored here.",
              "type": "string"
            }
          ]
        },
        "CredentialSourceId": {
          "description": "Stable id of a [`CredentialSource`].",
          "type": "string"
        },
        "CredentialStatus": {
          "description": "Lifecycle of a source.",
          "enum": [
            "active",
            "disabled",
            "archived"
          ],
          "type": "string"
        },
        "SecretRef": {
          "description": "Opaque handle into a [`SecretStore`]. Never the secret itself.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The stored credential row — **secret-free** (the read/serde projection). The\nsecret is reachable only via `material_ref` through the [`SecretStore`].",
      "properties": {
        "env_key": {
          "description": "Environment-variable name the secret is injected under (all kinds may set it).",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/CredentialSourceId"
        },
        "kind": {
          "$ref": "#/$defs/CredentialKind"
        },
        "material_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Vault reference; `None` for `Env` (the secret never crosses the control plane)."
        },
        "provider_id": {
          "description": "Provider namespace this credential authenticates (`anthropic`, `openai`).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/CredentialStatus"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "kind",
        "status",
        "version"
      ],
      "title": "CredentialSource",
      "type": "object"
    },
    "CredentialStatus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
