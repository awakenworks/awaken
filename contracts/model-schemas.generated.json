{
  "$comment": "GENERATED by awaken-admin-config-api export_schemas; do not edit.",
  "schemas": {
    "AgentMcpConfig": {
      "$defs": {
        "McpServerId": {
          "description": "A management-plane MCP server identifier.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Which MCP servers an agent uses — the management-plane agent↔MCP binding\n(ADR-0043 Phase 3). References [`McpServerDef`]s by id; the resolver\nmaterializes the referenced defs into [`ResolvedMcpServer`]s at run bind time.",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "mcp_server_ids": {
          "items": {
            "$ref": "#/$defs/McpServerId"
          },
          "type": "array"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "agent_id",
        "mcp_server_ids",
        "version"
      ],
      "title": "AgentMcpConfig",
      "type": "object"
    },
    "AgentResourceConfig": {
      "$defs": {
        "ResourceAccess": {
          "description": "Whether a bound resource is read-only or writable.",
          "enum": [
            "read_only",
            "read_write"
          ],
          "type": "string"
        },
        "ResourceBinding": {
          "description": "One resource bound to an agent. `resource_id` addresses the backing resource\n(a file/skill id, a memory store id, a repo URL; empty for the outputs mount);\n`mount_path` is where it appears in the sandbox; `instructions` is optional\nper-binding guidance rendered into the agent's system prompt.",
          "properties": {
            "access": {
              "$ref": "#/$defs/ResourceAccess"
            },
            "instructions": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "$ref": "#/$defs/ResourceKind"
            },
            "mount_path": {
              "type": "string"
            },
            "resource_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "mount_path",
            "access"
          ],
          "type": "object"
        },
        "ResourceKind": {
          "description": "The resource kind a binding realizes — one variant per ADR-0038 resource.",
          "oneOf": [
            {
              "const": "outputs",
              "description": "The outputs mount the host collects as artifacts.",
              "type": "string"
            },
            {
              "const": "file",
              "description": "An immutable file blob.",
              "type": "string"
            },
            {
              "const": "memory_store",
              "description": "A persistent, keyed memory store.",
              "type": "string"
            },
            {
              "const": "github_repository",
              "description": "A git working tree cloned from a remote.",
              "type": "string"
            },
            {
              "const": "skill",
              "description": "A versioned skill bundle.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Which resources an agent is bound to — the management-plane agent↔resource\nbinding (ADR-0038). At run bind time each [`ResourceBinding`] is materialized\ntwo ways: into a `MountRequirement` the sandbox realizes, and into a prompt\nfragment appended to the agent's effective system prompt (ADR-0038 A3a). Rows\nare secret-free — a private resource's credential is a binding by reference,\nresolved through the vault like MCP auth, never material here.",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceBinding"
          },
          "type": "array"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "agent_id",
        "resources",
        "version"
      ],
      "title": "AgentResourceConfig",
      "type": "object"
    },
    "ApiError": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "RFC 9457 Problem Details with stable application extension members (`code`, `request_id`, `details`, `errors`).",
      "properties": {
        "code": {
          "description": "Stable application error code; clients may branch on this.",
          "type": "string"
        },
        "detail": {
          "description": "Request-specific human-readable explanation.",
          "type": "string"
        },
        "details": {
          "description": "Type-specific structured metadata."
        },
        "errors": {
          "description": "Field/query/header violations for validation-style problems.",
          "items": {
            "properties": {
              "code": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "field",
              "code"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "instance": {
          "type": "string"
        },
        "request_id": {
          "description": "Correlation id echoed from the `x-request-id` header.",
          "type": "string"
        },
        "status": {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        "title": {
          "description": "Stable human-readable summary for this problem type.",
          "type": "string"
        },
        "type": {
          "description": "URI reference identifying the problem type.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "request_id"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "CredentialBinding": {
