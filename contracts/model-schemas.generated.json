    "EnterCredentialRequest": {
      "$defs": {
        "CredentialKind": {
          "description": "Where a secret physically lives (the materialization axis).",
          "oneOf": [
            {
              "const": "vault",
              "description": "Secret material sealed in the vault (a [`SecretRef`] into [`SecretStore`]).",
              "type": "string"
            },
            {
              "const": "env",
              "description": "A host environment variable named by `env_key`; nothing is stored here.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The credential-entry wire body. `secret` is write-only: it is sealed into the\n[`SecretStore`] and never appears on any response (the returned row is\nsecret-free). `RedactedString` is intentionally not `Deserialize`, so the raw\nsecret crosses the wire exactly once, here.",
      "properties": {
        "env_key": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/CredentialKind"
        },
        "provider_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "secret": {
          "default": "",
          "description": "The secret to seal — required for `vault`, unused for `env` (which reads a\nhost variable at materialization), so it defaults to empty.",
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "kind"
      ],
      "title": "EnterCredentialRequest",
      "type": "object"
    },
