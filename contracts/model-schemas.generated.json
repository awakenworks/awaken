      "$defs": {
        "ProjectId": {
          "description": "A management-plane project identifier. It doubles as the project's ingress\naddress segment (`/projects/{id}/…` or a per-project domain label), so it is\nconstrained to a DNS-safe lowercase slug at authoring time. The rule is the\nshared tenancy slug rule [`awaken_scope::scope::slug_is_valid`], so a project\nid validates identically here, in the scope tree, and across products.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A consumption-side project under a workspace (ADR-0042 amendment: the URL\ncarries the project as ADDRESSING only — tenancy and authority still flow\nfrom the API key's workspace). Supply (catalog, credentials, pools, MCP\ndefs) stays workspace-owned; a project only *selects* from it, so no secret\nis ever duplicated per project.",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ProjectId"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "display_name",
        "version"
      ],
      "title": "Project",
      "type": "object"
    },
    "ProjectAgentConfig": {
      "$defs": {
        "McpServerId": {
          "description": "A management-plane MCP server identifier.",
          "type": "string"
        },
        "ProjectId": {
          "description": "A management-plane project identifier. It doubles as the project's ingress\naddress segment (`/projects/{id}/…` or a per-project domain label), so it is\nconstrained to a DNS-safe lowercase slug at authoring time. The rule is the\nshared tenancy slug rule [`awaken_scope::scope::slug_is_valid`], so a project\nid validates identically here, in the scope tree, and across products.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Which MCP servers an agent uses *within one project* — the project-scoped\nconsumption binding. Shape mirrors [`AgentMcpConfig`] (the workspace-level\ndefault); a session created through `/projects/{id}/…` consults this first\nand falls back to the workspace binding when absent, so bare-path behavior\nis byte-identical to before projects existed.",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "mcp_server_ids": {
          "items": {
            "$ref": "#/$defs/McpServerId"
          },
          "type": "array"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "agent_id",
        "mcp_server_ids",
        "version"
      ],
      "title": "ProjectAgentConfig",
      "type": "object"
    },
    "ProtocolEndpoint": {
      "$defs": {
        "ModelApiCompat": {
          "description": "The wire/model-API dialect a surface speaks. Replaces oversight's `WireFormat`;\nthe credential/model bindings are resolved against this flavor (ADR-0043).",
          "oneOf": [
            {
              "const": "anthropic_messages",
              "description": "The `claude` adapter's wire.",
              "type": "string"
            },
            {
              "const": "open_ai_chat",
              "description": "The `codex`/OpenAI chat wire.",
              "type": "string"
            },
            {
              "const": "gemini",
              "description": "The Gemini wire.",
              "type": "string"
            }
          ]
        },
        "ProtocolEndpointId": {
          "description": "Stable id of a [`ProtocolEndpoint`].",
          "type": "string"
        },
        "ProviderId": {
          "description": "Stable id of a [`Provider`] (vendor namespace).",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A concrete protocol surface of a provider: which wire + which URL. Distinct\nflavors of one provider typically have distinct `base_url`s.",
      "properties": {
        "base_url": {
          "description": "`http(s)` base URL override (proxy / self-hosted / compat endpoint).",
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "flavor": {
          "$ref": "#/$defs/ModelApiCompat"
        },
        "id": {
          "$ref": "#/$defs/ProtocolEndpointId"
        },
        "provider_id": {
          "$ref": "#/$defs/ProviderId"
        },
        "timeout_secs": {
          "description": "Request timeout in seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "provider_id",
        "flavor",
        "timeout_secs",
        "display_name",
        "version"
      ],
      "title": "ProtocolEndpoint",
      "type": "object"
    },
    "Provider": {
      "$defs": {
        "ProviderId": {
          "description": "Stable id of a [`Provider`] (vendor namespace).",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A vendor namespace (`anthropic`, `openai`, …).",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ProviderId"
        },
        "slug": {
          "description": "URL-safe vendor slug, unique in the catalog.",
          "type": "string"
        },
        "version": {
          "description": "Append-only version bumped on change.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "slug",
        "display_name",
        "version"
      ],
      "title": "Provider",
      "type": "object"
    },
    "ProviderCatalog": {
      "$defs": {
        "ModelApiCompat": {
          "description": "The wire/model-API dialect a surface speaks. Replaces oversight's `WireFormat`;\nthe credential/model bindings are resolved against this flavor (ADR-0043).",
          "oneOf": [
            {
              "const": "anthropic_messages",
              "description": "The `claude` adapter's wire.",
              "type": "string"
            },
            {
              "const": "open_ai_chat",
              "description": "The `codex`/OpenAI chat wire.",
              "type": "string"
            },
            {
              "const": "gemini",
              "description": "The Gemini wire.",
              "type": "string"
            }
          ]
        },
        "Offering": {
          "description": "A model reachable on a protocol surface. `model_id` references the catalog's\n`ModelSpec` (the intrinsic model attributes, owned by `awaken-agent-contract`).",
          "properties": {
            "flavor": {
              "$ref": "#/$defs/ModelApiCompat"
            },
            "model_id": {
              "description": "The protocol-agnostic catalog model id (e.g. `claude-opus-4-8`).",
              "type": "string"
            },
            "protocol_endpoint_id": {
              "$ref": "#/$defs/ProtocolEndpointId"
            },
            "provider_id": {
              "$ref": "#/$defs/ProviderId"
            },
            "upstream_model": {
              "description": "Provider-canonical model name sent upstream when it differs from `model_id`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "model_id",
            "provider_id",
            "protocol_endpoint_id",
            "flavor"
          ],
          "type": "object"
        },
        "ProtocolEndpoint": {
          "description": "A concrete protocol surface of a provider: which wire + which URL. Distinct\nflavors of one provider typically have distinct `base_url`s.",
          "properties": {
            "base_url": {
              "description": "`http(s)` base URL override (proxy / self-hosted / compat endpoint).",
              "type": [
                "string",
                "null"
              ]
            },
            "display_name": {
              "type": "string"
            },
            "flavor": {
              "$ref": "#/$defs/ModelApiCompat"
            },
            "id": {
              "$ref": "#/$defs/ProtocolEndpointId"
            },
            "provider_id": {
              "$ref": "#/$defs/ProviderId"
            },
            "timeout_secs": {
              "description": "Request timeout in seconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "version": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "id",
            "provider_id",
            "flavor",
            "timeout_secs",
            "display_name",
            "version"
          ],
          "type": "object"
        },
        "ProtocolEndpointId": {
          "description": "Stable id of a [`ProtocolEndpoint`].",
          "type": "string"
        },
        "Provider": {
          "description": "A vendor namespace (`anthropic`, `openai`, …).",
          "properties": {
            "display_name": {
              "type": "string"
            },
            "id": {
              "$ref": "#/$defs/ProviderId"
            },
            "slug": {
              "description": "URL-safe vendor slug, unique in the catalog.",
              "type": "string"
            },
            "version": {
              "description": "Append-only version bumped on change.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "id",
            "slug",
            "display_name",
            "version"
          ],
          "type": "object"
        },
        "ProviderId": {
          "description": "Stable id of a [`Provider`] (vendor namespace).",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The catalog aggregate: providers, their endpoints, and the offerings across\nthem. The in-memory projection the resolver queries.",
      "properties": {
        "endpoints": {
          "additionalProperties": {
            "$ref": "#/$defs/ProtocolEndpoint"
          },
          "type": "object"
        },
        "offerings": {
          "items": {
            "$ref": "#/$defs/Offering"
          },
          "type": "array"
        },
        "providers": {
          "additionalProperties": {
            "$ref": "#/$defs/Provider"
          },
          "type": "object"
        }
      },
      "required": [
        "providers",
        "endpoints",
        "offerings"
      ],
      "title": "ProviderCatalog",
      "type": "object"
    },
    "ResolveAgentMcpRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Resolve an agent's MCP binding within a workspace's credential scope.",
      "properties": {
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id"
      ],
      "title": "ResolveAgentMcpRequest",
      "type": "object"
    },
    "ResolveProfileRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Resolve an authored profile within a workspace's credential scope.",
      "properties": {
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id"
      ],
      "title": "ResolveProfileRequest",
      "type": "object"
    },
    "ResolveRequest": {
      "$defs": {
        "CredentialBinding": {
          "description": "The \"which credential\" axis (oversight-next / awaken-management-contract).",
          "oneOf": [
            {
              "description": "No credential is needed.",
              "properties": {
                "type": {
                  "const": "none",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "description": "Use exactly one source.",
              "properties": {
                "credential_source_id": {
                  "$ref": "#/$defs/CredentialSourceId"
                },
                "type": {
                  "const": "exact",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "credential_source_id"
              ],
              "type": "object"
            },
            {
              "description": "Use one eligible member of a pool; the resolver selects by policy and may\nfail over to the next member if the chosen one cannot be materialized.",
              "properties": {
                "credential_pool_id": {
                  "$ref": "#/$defs/CredentialPoolId"
                },
                "type": {
                  "const": "one_of_credential_pool",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "credential_pool_id"
              ],
              "type": "object"
            }
          ]
        },
        "CredentialPoolId": {
          "description": "A credential pool identifier.",
          "type": "string"
        },
        "CredentialSourceId": {
          "description": "Stable id of a [`CredentialSource`].",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A dry-run resolve request: bind `model_id` (+ credential `binding`) against the\nauthored catalog. The workspace scopes which credential sources are visible.",
      "properties": {
        "binding": {
          "$ref": "#/$defs/CredentialBinding"
        },
        "model_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "model_id",
        "binding"
      ],
      "title": "ResolveRequest",
      "type": "object"
    },
    "ResolvedInferenceView": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The **secret-free** result of a resolve (ADR-0043): the execution triple + the\nadapter/endpoint it binds to, and whether a credential resolved — never the\nsecret itself. This is what an operator's \"test binding\" call sees.",
      "properties": {
        "adapter_kind": {
          "type": "string"
        },
        "base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "credential_present": {
          "description": "Whether a credential was materialized (never the value).",
          "type": "boolean"
        },
        "model_id": {
          "type": "string"
        },
        "protocol_endpoint_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "provider_id",
        "protocol_endpoint_id",
        "adapter_kind",
        "credential_present"
      ],
      "title": "ResolvedInferenceView",
      "type": "object"
    },
    "ResolvedMcpServerView": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The **secret-free** projection of a resolved MCP server (ADR-0043): what the\nagent's binding materializes to, and whether a credential resolved — never the\nsecret itself. This is what an operator's \"test binding\" call sees.",
      "properties": {
        "credential_present": {
          "description": "Whether a credential was materialized (never the value).",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "credential_present"
      ],
      "title": "ResolvedMcpServerView",
      "type": "object"
    },
    "ValidateCredentialRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Live-validate a credential against a model's resolved provider endpoint.",
      "properties": {
        "model_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "model_id"
      ],
      "title": "ValidateCredentialRequest",
      "type": "object"
    }
  },
  "version": "0"
}
