          "description": "The result of a live credential probe (secret-free), aligned with the Managed\nwire's `valid` / `invalid` / `unknown` statuses.",
          "enum": [
            "valid",
            "invalid",
            "unknown"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The secret-free result of a live credential probe.",
      "properties": {
        "adapter_kind": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProbeStatus"
        }
      },
      "required": [
        "status",
        "adapter_kind"
