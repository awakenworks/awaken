      "remaining": [
        "沿用 BlockingCommit/Notify/数据库时钟见证；不要用固定 sleep 或时间阈值替代状态断言。",
        "共享 assert_lease_renewal 已含 LR1-LR8，但到期边界 renew/reclaim 的两个强制并发先后次序仍需独立 PostgreSQL 连接和 barrier 用例。"
      ],
      "backend_scope": "该组 PG 用例证明权威数据库行为；lease_semantics 中 Memory/SQLite 用例补充跨层真实执行/取消/物理 ACK 规则，不能合计为纯 PG 测试数量。",
      "decision_rules": [
        {
          "id": "LR-current",
          "when": "当前精确 Run/owner/epoch renew，原租期已过但新 deadline 尚未过",
          "expect": "Current；另一 owner claim=None",
          "existing_case": "lease_renewal_on_postgres"
        },
        {
          "id": "LR-unreclaimed-expired",
          "when": "旧 deadline 已过且 claim_is_current=false，但未发生 successor claim；精确 claim renew(0)",
          "expect": "仍是 Current（行 CAS 语义）；不能改为仅按 Lease::is_live_at 拒绝",
          "existing_case": "lease_renewal_on_postgres"
        },
        {
          "id": "LR-reused-owner",
          "when": "相同 owner 字符串重新 claim 后，旧 epoch renew 或 settle",
          "expect": "旧 epoch Lost/拒绝；replacement 不变",
          "existing_case": "lease_renewal_on_postgres"
        },
        {
          "id": "LR-guard",
          "when": "commit guard 持有，回收请求在 guard 释放前完成或仍等待",
          "expect": "释放前不得获得 row；释放后可 claim 且 epoch 增加",
          "existing_case": "postgres_epoch_guard_prevents_reclaim_until_commit_returns"
        },
        {
          "id": "LR-physical",
          "when": "外部执行 Future 未返回/已返回且记录了精确 quiescence",
          "expect": "未返回不能 ACK 清槽；已静止后按 NeverReplay 生成一个 Indeterminate 终态，不重放工具",
          "existing_case": "postgres_reclaim_after_process_bound_attempt_quiesces_applies_never_replay_policy",
          "companion_cases": [
            "physical_ack_waits_for_all_participants_memory",
            "physical_ack_waits_for_all_participants_sqlite",
            "killed_process_does_not_fabricate_physical_quiescence_on_sqlite_reopen",
            "native_cancelled_external_future_does_not_acknowledge_physical_return"
          ]
        }
      ],
      "planned_regressions": [
        {
          "id": "renew-before-reclaim",
          "implementation": "deferred-rust",
          "when": "真实 PostgreSQL 两个独立连接，在过期同一行上用 barrier 使 renew 先取得 row lock；renew 使用正 TTL",
          "expect": "renew Current；随后 reclaim None；权威记录保持原 epoch 且 deadline 更新"
        },
        {
          "id": "reclaim-before-renew",
          "implementation": "deferred-rust",
          "when": "相同行过期边界，使另一连接 reclaim 先提交 successor epoch，再释放旧 renew",
          "expect": "successor 恰好一个；旧 renew Lost；旧 settle 不改变 successor 或提交历史"
        }
      ]
    },
