        "L1",
        "L2",
        "L3"
      ]
    },
    {
      "id": "service-process",
      "when": "API、部署、consumer、harness 或 E2E 改动保留真实服务和进程边界断言；纯测试不替代实际交付。",
      "required": [
        "L0",
        "L2",
        "L3"
      ]
    },
    {
      "id": "global",
      "when": "manifest/lock/toolchain/Cargo 配置/feature profile/CI 或 hook 改动保留 whole Rust graph，并补冷缓存验证。",
      "required": [
