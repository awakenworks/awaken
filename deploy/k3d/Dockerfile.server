# Server/worker runtime image for k3d scenarios that do not launch a hand plane.
# The host-built scenario binary selects its role through AWAKEN_ROLE.
FROM ubuntu:24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY awaken-server /usr/local/bin/awaken-server

ENTRYPOINT ["/usr/local/bin/awaken-server"]
