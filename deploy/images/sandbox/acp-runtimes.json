{
  "schema_version": 1,
  "runtimes": [
    {
      "id": "claude",
      "manager": "npm",
      "requirement": "@agentclientprotocol/claude-agent-acp@0.64.2",
      "probe_argv": ["claude-agent-acp"],
      "auth_method_id": null
    },
    {
      "id": "codex",
      "manager": "npm",
      "requirement": "@agentclientprotocol/codex-acp@1.1.9",
      "probe_argv": [
        "/usr/bin/env",
        "OPENAI_API_KEY=awaken-capability-probe",
        "codex-acp"
      ],
      "auth_method_id": "api-key"
    },
    {
      "id": "gemini",
      "manager": "npm",
      "requirement": "@google/gemini-cli@0.53.1",
      "probe_argv": [
        "/usr/bin/env",
        "GEMINI_API_KEY=awaken-capability-probe",
        "gemini",
        "--acp"
      ],
      "auth_method_id": null
    },
    {
      "id": "opencode",
      "manager": "npm",
      "requirement": "opencode-ai@1.18.12",
      "probe_argv": ["opencode", "acp"],
      "auth_method_id": null
    },
    {
      "id": "hermes",
      "manager": "pip",
      "requirement": "hermes-agent[acp,bedrock]==0.19.0",
      "probe_argv": [
        "/usr/bin/env",
        "DEEPSEEK_API_KEY=awaken-capability-probe",
        "DEEPSEEK_BASE_URL=https://api.deepseek.com/v1",
        "HERMES_MODEL=deepseek-v4-flash",
        "hermes-acp"
      ],
      "auth_method_id": null
    }
  ]
}
