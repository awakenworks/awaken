+    /// Bind semantic Rust names only after this exact harness has been linked.
+    /// The original profile still owns every bound; these queries own no proof
+    /// settings and never modify the GOTO or introduce another verifier.
+    fn bind_profile_unwindset(&self, file: &Path, args: &mut [OsString]) -> Result<()> {
+        if !profile_binding::needs_binding(args) {
+            return Ok(());
+        }
+        use kani_metadata::{ArtifactType, artifact::convert_type};
+        let names = std::fs::File::open(convert_type(
+            file,
+            ArtifactType::Goto,
+            ArtifactType::PrettyNameMap,
+        ))?;
+        let names = serde_json::from_reader(names)?;
+        let query = |flag: &str| -> Result<serde_json::Value> {
+            let mut command = std::process::Command::new("goto-instrument");
+            command.args([flag, "--json-ui"]).arg(file);
+            let output = self.run_piped(command)?.wait_with_output()?;
+            anyhow::ensure!(
+                output.status.success(),
+                "profile artifact query {flag} failed: {}",
+                output.status
+            );
+            Ok(serde_json::from_slice(&output.stdout)?)
+        };
+        let symbols = query("--show-symbol-table")?;
+        let loops = query("--show-loops")?;
+        profile_binding::bind(args, &names, &symbols, &loops)
+    }
