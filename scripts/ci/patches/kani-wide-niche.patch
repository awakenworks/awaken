+}
+
+#[cfg(test)]
+mod artifact_profile_diagnostics {
+    use super::*;
+
+    #[test]
+    fn artifact_profile_json_errors_survive_the_real_terse_renderer() {
+        // D1 parsed backend ERROR -> retain its exact reason in terse output;
+        // D2 STATUS-MESSAGE -> remain terse. The input is CBMC's actual JSON
+        // shape and this calls the production formatter, not a fake Cargo port
+        // conditioned on --verbose. Neither outcome changes verification status.
+        for (kind, expected) in
+            [("ERROR", Some("Invalid User Input: unwindset".into())), ("STATUS-MESSAGE", None)]
+        {
+            let json = serde_json::json!({"messageType":kind,"messageText":"Invalid User Input: unwindset"});
+            let item: ParserItem = serde_json::from_value(json).unwrap();
+            assert_eq!(format_item_terse(&item), expected, "{kind}");
+        }
+    }
 }

