+TEST_CASE(
+  "SMT binder-free and other-solver definitions remain unchanged",
+  "[core][solvers][smt2]")
+{
+  smt2_binder_testt test;
+  const auto backend = GENERATE(
+    smt2_convt::solvert::Z3,
+    smt2_convt::solvert::GENERIC,
+    smt2_convt::solvert::CVC5);
+  std::ostringstream output;
+  smt2_convt solver{test.ns, "controls", "", "ALL", backend, output};
+  const symbol_exprt plain{"plain", test.byte};
+  solver.set_to(equal_exprt{plain, from_integer(7, test.byte)}, true);
+  // L7: binder-free definitions keep their original optimization everywhere.
+  CHECK(output.str().find("(define-fun plain () (_ BitVec 8) ") !=
+        std::string::npos);
+  if(backend != smt2_convt::solvert::Z3)
+  {
+    // L8: other backends keep their existing fresh-symbol definition path;
+    // array comprehensions are their existing quantified auxiliary arrays.
+    const symbol_exprt array{"array", test.array_type};
+    solver.set_to(equal_exprt{array, test.comprehension}, true);
+    CHECK(output.str().find("(define-fun array () (Array ") !=
+          std::string::npos);
+    CHECK(output.str().find("(lambda (") == std::string::npos);
+    const symbol_exprt quantified{"quantified", bool_typet{}};
+    solver.set_to(
+      equal_exprt{
+        quantified,
+        forall_exprt{{test.index}, equal_exprt{test.index, test.index}}},
+      true);
+    CHECK(output.str().find("(define-fun quantified () Bool ") !=
+          std::string::npos);
+  }
+}
