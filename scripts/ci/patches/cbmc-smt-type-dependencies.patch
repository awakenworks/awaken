+TEST_CASE(
+  "SMT Boolean binder handles and typed assignments share detection",
+  "[core][solvers][smt2]")
+{
+  smt2_binder_testt test;
+  exprt predicate = equal_exprt{
+    index_exprt{test.comprehension, from_integer(1, test.index_type)},
+    from_integer(1, test.byte)};
+  SECTION("Lambda in Boolean handle")
+  {
+    // L4: a Boolean expression can contain a lambda directly, without any
+    // typed symbol assignment. Reuse the existing declare/assert handle path.
+  }
+  SECTION("Existential quantifier")
+  {
+    // L5: existing quantifier handles stay declared; assigning a quantified
+    // RHS to a fresh Boolean symbol now also prevents a binder-bearing macro.
+    predicate = exists_exprt{
+      {test.index}, equal_exprt{test.index, from_integer(1, test.index_type)}};
+  }
+  SECTION("Universal quantifier")
+  {
+    // L6: both quantifier kinds participate in the same predicate.
+    predicate = forall_exprt{
+      {test.index}, equal_exprt{test.index, test.index}};
+  }
+  test.converter.handle(predicate);
+  const symbol_exprt assigned{"assigned", bool_typet{}};
+  test.converter.set_to(equal_exprt{assigned, predicate}, true);
+  CHECK(test.converter() == decision_proceduret::resultt::D_ERROR);
+  const auto output = test.output.str();
+  CHECK(output.find("(declare-fun B0 () Bool)") != std::string::npos);
+  CHECK(output.find("(assert (= B0 ") != std::string::npos);
+  CHECK(output.find("(declare-fun assigned () Bool)") != std::string::npos);
+  CHECK(output.find("(assert (= assigned ") != std::string::npos);
+  CHECK(output.find("(define-fun assigned ") == std::string::npos);
+  const auto query = output.substr(output.find("(get-value ("));
+  CHECK(query.find("B0") != std::string::npos);
+  CHECK(query.find("assigned") != std::string::npos);
+}
