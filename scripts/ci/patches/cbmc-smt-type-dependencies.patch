+TEST_CASE(
+  "SMT binder origins preserve real Z3 Boolean model semantics",
+  "[.][solvers][smt2][smt2-z3]")
+{
+  smt2_binder_testt test;
+  null_message_handlert messages;
+  smt2_dect solver{
+    test.ns,
+    "binder semantics",
+    "",
+    "ALL",
+    smt2_convt::solvert::Z3,
+    "",
+    messages};
+  const auto shape = GENERATE(0, 1, 2);
+  exprt rhs = test.comprehension;
+  if(shape != 0)
+  {
+    const symbol_exprt condition{"condition", bool_typet{}};
+    solver.set_to(
+      equal_exprt{condition, from_integer(shape == 1, bool_typet{})}, true);
+    rhs = if_exprt{
+      condition,
+      with_exprt{
+        test.comprehension,
+        from_integer(0, test.index_type),
+        from_integer(42, test.byte)},
+      test.comprehension};
+  }
+  const auto property = test.alias_chain(solver, rhs);
+  const symbol_exprt first{"first", test.byte};
+  solver.set_to(
+    equal_exprt{
+      first,
+      index_exprt{
+        symbol_exprt{"alias", test.array_type},
+        from_integer(0, test.index_type)}},
+    true);
+  const auto expected_first = from_integer(shape == 1 ? 42 : 0, test.byte);
+  solver.set_to(equal_exprt{first, expected_first}, true);
+  const bool expect_sat = GENERATE(true, false);
+  // L9/L10: opt-in integration test, with Z3 selected from the caller's PATH.
+  // The canonical converter constructs the whole formula and requests every
+  // identifier. Direct and both guarded-store branches retain A[1] == 1;
+  // its negation is unsatisfiable. Also require A[0] == 42 exactly when the
+  // store branch is selected. Check Boolean/scalar values, not partial array
+  // models, to cover both the preserved guard and the actual update semantics.
+  solver.set_to(property, expect_sat);
+  const auto result = solver();
+  if(expect_sat)
+  {
+    REQUIRE(result == decision_proceduret::resultt::D_SATISFIABLE);
+    CHECK(solver.get(property) == true_exprt{});
+    CHECK(solver.get(first) == expected_first);
+    CHECK(solver.get(symbol_exprt{"selected", test.byte}) ==
+          from_integer(1, test.byte));
+  }
+  else
+    CHECK(result == decision_proceduret::resultt::D_UNSATISFIABLE);
+}
