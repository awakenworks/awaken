+TEST_CASE(
+  "SMT binder detection runs after byte-operation lowering",
+  "[core][solvers][smt2]")
+{
+  smt2_binder_testt test;
+  const array_typet variable_array{
+    test.byte, symbol_exprt{"length", test.index_type}};
+  const symbol_exprt result{"bytes", variable_array};
+  const byte_extract_exprt extract{
+    ID_byte_extract_little_endian,
+    symbol_exprt{"packed", unsignedbv_typet{64}},
+    from_integer(0, test.index_type),
+    8,
+    variable_array};
+
+  // L3: the source RHS has no comprehension, but lowering a variable-sized
+  // byte extraction introduces one. Checking the unprepared RHS misses this
+  // binder. Preserve the lowered lambda and request the assigned identifier.
+  test.converter.set_to(equal_exprt{result, extract}, true);
+  CHECK(test.converter() == decision_proceduret::resultt::D_ERROR);
+  const auto output = test.output.str();
+  CHECK(output.find("(lambda (") != std::string::npos);
+  CHECK(output.find("(declare-fun bytes () (Array ") != std::string::npos);
+  CHECK(output.find("(assert (= bytes ") != std::string::npos);
+  CHECK(output.find("(define-fun bytes ") == std::string::npos);
+  const auto query = output.substr(output.find("(get-value ("));
+  CHECK(query.find("bytes") != std::string::npos);
+  CHECK(query.find("length") != std::string::npos);
+  CHECK(query.find("packed") != std::string::npos);
+}
