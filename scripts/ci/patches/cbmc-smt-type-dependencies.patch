+TEST_CASE(
+  "SMT binder origins stop transitive lambda definitions",
+  "[core][solvers][smt2]")
+{
+  smt2_binder_testt test;
+  exprt rhs = test.comprehension;
+  bool nested = false;
+  SECTION("Direct comprehension")
+  {
+    // L1: a direct lambda origin must be a declared array constrained by its
+    // complete RHS, so alias -> select -> Boolean definitions remain queryable.
+  }
+  SECTION("Nested ite and store")
+  {
+    // L2: detection visits the entire RHS, including nested ite/store operands;
+    // no guard or array update may be lost when changing the outer wrapper.
+    nested = true;
+    rhs = if_exprt{
+      symbol_exprt{"condition", bool_typet{}},
+      with_exprt{
+        test.comprehension,
+        from_integer(0, test.index_type),
+        from_integer(42, test.byte)},
+      test.comprehension};
+  }
+  test.alias_chain(test.converter, rhs);
+  CHECK(test.converter() == decision_proceduret::resultt::D_ERROR);
+  const auto output = test.output.str();
+  CHECK(output.find("(declare-fun array () (Array ") != std::string::npos);
+  CHECK(output.find("(assert (= array ") != std::string::npos);
+  CHECK(output.find("(lambda ((i ") != std::string::npos);
+  CHECK(output.find("(define-fun array ") == std::string::npos);
+  if(nested)
+  {
+    CHECK(output.find("(ite condition ") != std::string::npos);
+    CHECK(output.find("(store ") != std::string::npos);
+    CHECK(output.find("(_ bv42 8)") != std::string::npos);
+  }
+  CHECK(output.find("(define-fun alias () (Array ") != std::string::npos);
+  CHECK(output.find("(define-fun selected () (_ BitVec 8) (select alias ") !=
+        std::string::npos);
+  const auto query = output.substr(output.find("(get-value ("));
+  CHECK(query.find("B0") != std::string::npos);
+  CHECK(query.find("alias") != std::string::npos);
+  CHECK(query.find("array") != std::string::npos);
+  CHECK(query.find("selected") != std::string::npos);
+}
