+struct smt2_binder_testt : smt2_type_discovery_testt
+{
+  const unsignedbv_typet byte{8};
+  const unsignedbv_typet index_type{64};
+  const array_typet array_type{byte, from_integer(2, index_type)};
+  const symbol_exprt index{"i", index_type};
+  const array_comprehension_exprt comprehension{
+    index, typecast_exprt{index, byte}, array_type};
+
+  exprt alias_chain(smt2_convt &solver, const exprt &rhs)
+  {
+    const symbol_exprt array{"array", array_type};
+    const symbol_exprt alias{"alias", array_type};
+    const symbol_exprt selected{"selected", byte};
+    solver.set_to(equal_exprt{array, rhs}, true);
+    solver.set_to(equal_exprt{alias, array}, true);
+    solver.set_to(
+      equal_exprt{selected, index_exprt{alias, from_integer(1, index_type)}},
+      true);
+    return solver.handle(equal_exprt{selected, from_integer(1, byte)});
+  }
+};
