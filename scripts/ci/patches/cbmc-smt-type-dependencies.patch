+    output.find("(declare-fun parameter_size () (_ BitVec 64))") !=
+    std::string::npos);
+  CHECK(
+    output.find("(declare-fun return_size () (_ BitVec 64))") !=
+    std::string::npos);
+  CHECK(output.find("(declare-datatypes") == std::string::npos);
+}
