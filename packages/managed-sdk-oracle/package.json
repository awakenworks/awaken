{
  "name": "@awaken/managed-sdk-oracle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./current-types": "./src/current-types.ts",
    "./current-wire": "./src/current-wire.generated.ts"
  },
  "scripts": {
    "conformance:hosted": "node src/conformance/hosted.mjs",
    "conformance:recovery:prepare": "node src/conformance/recovery.mjs prepare",
    "conformance:recovery:verify": "node src/conformance/recovery.mjs verify",
    "conformance:recovery:cleanup": "node src/conformance/recovery.mjs cleanup",
    "generate": "node src/cli.mjs generate",
    "check": "node src/cli.mjs check",
    "test": "node --test test/*.test.mjs && node --experimental-strip-types --test test/*.test.ts && tsc -p tsconfig.json && pnpm run test:behavior",
    "test:behavior": "cargo test --manifest-path ../../Cargo.toml -p awaken-protocol-managed --all-features --locked"
  },
  "dependencies": {
    "@anthropic-ai/sdk-current": "npm:@anthropic-ai/sdk@0.122.0",
    "@anthropic-ai/sdk-oldest": "npm:@anthropic-ai/sdk@0.105.0",
    "@anthropic-ai/sdk-user-profiles-legacy": "npm:@anthropic-ai/sdk@0.117.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "26.1.0"
  }
}
