{
  "name": "@awaken/managed-sdk-oracle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src/current-types.ts",
    "README.md"
  ],
  "exports": {
    "./current-types": "./src/current-types.ts",
    "./current-wire": {
      "types": "./dist/current-wire.generated.d.ts",
      "import": "./dist/current-wire.generated.js"
    }
  },
  "scripts": {
    "conformance:hosted": "node src/conformance/hosted.mjs",
    "conformance:release": "node src/conformance/release.mjs",
    "conformance:recovery:prepare": "node src/conformance/recovery.mjs prepare",
    "conformance:recovery:verify": "node src/conformance/recovery.mjs verify",
    "conformance:recovery:cleanup": "node src/conformance/recovery.mjs cleanup",
    "generate": "node src/cli.mjs generate",
    "generate:python": "python3 python/oracle.py generate",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "check": "node src/cli.mjs check && python3 python/oracle.py check",
    "check:python:online": "python3 python/oracle.py canary",
    "test": "python3 -m unittest discover -s python -p \"test_*.py\" && node --test test/*.test.mjs && node --experimental-strip-types --test test/*.test.ts && tsc -p tsconfig.json && pnpm run test:behavior",
    "test:behavior": "python3 ../../scripts/ci/_native_shell.py ../../scripts/ci/check_managed_sdk_behavior.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk-beta-resources-legacy": "npm:@anthropic-ai/sdk@0.121.0",
    "@anthropic-ai/sdk-candidate": "npm:@anthropic-ai/sdk@0.132.1",
    "@anthropic-ai/sdk-current": "npm:@anthropic-ai/sdk@0.132.1",
    "@anthropic-ai/sdk-oldest": "npm:@anthropic-ai/sdk@0.105.0",
    "@anthropic-ai/sdk-user-profiles-legacy": "npm:@anthropic-ai/sdk@0.117.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "26.1.0"
  }
}
