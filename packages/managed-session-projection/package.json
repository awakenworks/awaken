{
  "name": "@awaken/managed-session-projection",
  "version": "0.1.1",
  "description": "Product-neutral committed-event and live-preview projection helpers for Awaken Managed Sessions.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "TESTING.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "pnpm --filter @awaken/managed-sdk-oracle build && pnpm build && vitest run src && node --test test/*.test.mjs",
    "typecheck": "pnpm --filter @awaken/managed-sdk-oracle build && pnpm build && tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "pack:portable": "node scripts/pack-portable.mjs"
  },
  "dependencies": {
    "@awaken/managed-sdk-oracle": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
